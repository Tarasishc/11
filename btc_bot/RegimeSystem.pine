//@version=5
// ============================================================================
//  BTC REGIME SYSTEM — Long у бику + Short у ведмежці (єдина система)
//  Над EMA200 = ЛОНГ (Bollinger / VMC / RSI2); під EMA200 + EMA50<EMA200 = ШОРТ.
//  Таймфрейм: 4H.  ▲LONG / ▼SHORT — вхід, ✕EXIT — вихід.
//  Лінії: біла=ТВХ(вхід), червона=стоп, зелена=тейк. Фон: зелений=бик, червоний=ведмідь.
// ============================================================================
indicator("BTC Regime System (Long+Short)", shorttitle="RegimeSys", overlay=true, max_labels_count=500)

gT="Тренд / режим"
emaFastLen=input.int(50, "EMA Fast (50)", group=gT)
emaSlowLen=input.int(200,"EMA Slow (200)", group=gT)
emaMidLen =input.int(100,"EMA Mid (100)",  group=gT)

gL="ЛОНГ-входи (бик)"
useBB   =input.bool(true,"Bollinger-пробій", group=gL)
bbLen   =input.int(20,"BB Length", group=gL)
bbMult  =input.float(2.0,"BB Mult", step=0.1, group=gL)
useVMC  =input.bool(true,"VMC-перепроданість (WT крос ≤ -53)", group=gL)
useRSI2 =input.bool(true,"RSI(2) < 10", group=gL)
lStop   =input.float(1.5,"Лонг: стоп (×ATR)", step=0.25, group=gL)
lTrail  =input.float(4.0,"Лонг: трейл (×ATR)", step=0.5, group=gL)

gS="ШОРТ-входи (ведмідь)"
useRipRSI =input.bool(true,"RSI(14) rip > 60", group=gS)
rsiTrig   =input.int(60,"RSI rip рівень", group=gS)
useRej100 =input.bool(true,"Відбій від EMA100", group=gS)
useCross50=input.bool(true,"Ралі крізь EMA50", group=gS)
sStop     =input.float(1.25,"Шорт: стоп (×ATR)", step=0.25, group=gS)
sTrail    =input.float(5.0,"Шорт: трейл (×ATR)", step=0.5, group=gS)

gX="Тейк / вихід"
takeRR    =input.float(3.0,"Тейк (× ризику, RR)", step=0.5, group=gX)
useFixedTake=input.bool(false,"Виходити по тейку (інакше — трейлінг)", group=gX)

gA="ATR / вигляд"
atrLen=input.int(14,"ATR Length", group=gA)
showZone=input.bool(true,"Підсвічувати режим", group=gA)

emaFast=ta.ema(close,emaFastLen)
emaSlow=ta.ema(close,emaSlowLen)
emaMid =ta.ema(close,emaMidLen)
atrVal =ta.atr(atrLen)
rsi14  =ta.rsi(close,14)
rsi2   =ta.rsi(close,2)
bbUpper=ta.sma(close,bbLen)+bbMult*ta.stdev(close,bbLen)
esa=ta.ema(hlc3,9)
de =ta.ema(math.abs(hlc3-esa),9)
ci =(hlc3-esa)/(0.015*de)
wt1=ta.ema(ci,12)
wt2=ta.sma(wt1,3)

bullRegime = close > emaSlow
bearRegime = emaFast < emaSlow and close < emaSlow

longSig  = (useBB and ta.crossover(close, bbUpper)) or (useVMC and ta.crossover(wt1, wt2) and wt2 <= -53) or (useRSI2 and ta.crossunder(rsi2, 10))
shortSig = (useRipRSI and ta.crossover(rsi14, rsiTrig)) or (useRej100 and high >= emaMid and close < emaMid) or (useCross50 and ta.crossover(close, emaFast))

var int   pos       = 0
var float entryPx   = na
var float stopLevel = na
var float takeLevel = na
var float ext       = na

enterLong  = pos==0 and bullRegime and longSig and atrVal>0
enterShort = pos==0 and bearRegime and shortSig and atrVal>0

if enterLong
    pos := 1
    entryPx := close
    stopLevel := close - lStop*atrVal
    takeLevel := close + takeRR*(lStop*atrVal)
    ext := high
else if enterShort
    pos := -1
    entryPx := close
    stopLevel := close + sStop*atrVal
    takeLevel := close - takeRR*(sStop*atrVal)
    ext := low

exitLong  = false
exitShort = false
exitPx    = float(na)
if pos==1 and not enterLong
    ext := math.max(ext, high)
    stopLevel := math.max(stopLevel, ext - lTrail*atrVal)
    if low <= stopLevel
        exitLong := true
        exitPx := stopLevel
        pos := 0
    else if useFixedTake and high >= takeLevel
        exitLong := true
        exitPx := takeLevel
        pos := 0
else if pos==-1 and not enterShort
    ext := math.min(ext, low)
    stopLevel := math.min(stopLevel, ext + sTrail*atrVal)
    if high >= stopLevel
        exitShort := true
        exitPx := stopLevel
        pos := 0
    else if useFixedTake and low <= takeLevel
        exitShort := true
        exitPx := takeLevel
        pos := 0

// ---- EMA та фон ----
plot(emaFast, "EMA50",  color=color.new(color.orange,0))
plot(emaMid,  "EMA100", color=color.new(#2196f3,0))
plot(emaSlow, "EMA200", color=color.new(color.gray,0), linewidth=2)
bgcolor(showZone and bullRegime ? color.new(color.green,93) : showZone and bearRegime ? color.new(color.red,92) : na, title="Режим")

// ---- ЛІНІЇ: ТВХ / СТОП / ТЕЙК (поки у позиції) ----
plot(pos!=0 ? entryPx   : na, "ТВХ (вхід)", color=color.new(color.white,0),   style=plot.style_linebr, linewidth=2)
plot(pos!=0 ? stopLevel : na, "СТОП",       color=color.new(color.red,0),     style=plot.style_linebr, linewidth=2)
plot(pos!=0 ? takeLevel : na, "ТЕЙК",       color=color.new(color.aqua,0),    style=plot.style_linebr, linewidth=2)

// ---- Стрілки + великі підписи ----
plotshape(enterLong,  title="LONG вхід",  style=shape.triangleup,   location=location.belowbar, color=color.new(color.lime,0), size=size.large, text="LONG")
plotshape(enterShort, title="SHORT вхід", style=shape.triangledown, location=location.abovebar, color=color.new(color.red,0),  size=size.large, text="SHORT")
plotshape(exitLong or exitShort, title="EXIT", style=shape.xcross, location=location.absolute, color=color.new(color.yellow,0), size=size.small)

if enterLong
    label.new(bar_index, low,  "LONG @ "+str.tostring(close,format.mintick)+"\nстоп "+str.tostring(stopLevel,format.mintick)+" | тейк "+str.tostring(takeLevel,format.mintick), yloc=yloc.belowbar, color=color.new(color.green,0), textcolor=color.white, style=label.style_label_up, size=size.large)
if enterShort
    label.new(bar_index, high, "SHORT @ "+str.tostring(close,format.mintick)+"\nстоп "+str.tostring(stopLevel,format.mintick)+" | тейк "+str.tostring(takeLevel,format.mintick), yloc=yloc.abovebar, color=color.new(color.red,0), textcolor=color.white, style=label.style_label_down, size=size.large)
if exitLong or exitShort
    label.new(bar_index, exitLong ? high : low, "EXIT @ "+str.tostring(exitPx,format.mintick), yloc=exitLong?yloc.abovebar:yloc.belowbar, color=color.new(color.gray,0), textcolor=color.white, style=exitLong?label.style_label_down:label.style_label_up, size=size.normal)

// ---- Алерти ----
alertcondition(enterLong,  title="LONG вхід",  message="RegimeSys: ВІДКРИТИ ЛОНГ {{ticker}} @ {{close}}")
alertcondition(enterShort, title="SHORT вхід", message="RegimeSys: ВІДКРИТИ ШОРТ {{ticker}} @ {{close}}")
alertcondition(exitLong,   title="LONG вихід", message="RegimeSys: ЗАКРИТИ ЛОНГ {{ticker}} @ {{close}}")
alertcondition(exitShort,  title="SHORT вихід",message="RegimeSys: ЗАКРИТИ ШОРТ {{ticker}} @ {{close}}")
alertcondition(enterLong or enterShort or exitLong or exitShort, title="Будь-який сигнал", message="RegimeSys: сигнал {{ticker}} @ {{close}}")
