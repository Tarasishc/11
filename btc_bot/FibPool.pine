//@version=5
// ============================================================================
//  BTC FIB 0.886 POOL — відточена стратегія (long + short, фіба 0.886)
//  Працює на поточному ТФ. Рекомендовано застосувати на 1H і 4H окремо.
//  Логіка (з бектесту, OOS-стійка, ~10%/міс @ 5bps, 4 угоди/тиж, RR ~1.8):
//    LONG : аптренд (close>EMA200), відкат до 0.886 ноги вгору, RSI>40
//    SHORT: даунтренд (close<EMA200), відскок до 0.886 ноги вниз, RSI<60
//    Фільтри (обидві сторони): обсяг ≥ SMA20(vol),  ADX ≥ 20
//    Стоп = свінг-low/high ± 0.5·ATR.  Тейк = вхід ± RR·ризик.
//  Лінії: біла=ТВХ, червона=стоп, бірюзова=тейк.  Фон: зел=бик / черв=ведмідь.
// ============================================================================
indicator("BTC Fib 0.886 Pool", shorttitle="FibPool", overlay=true, max_labels_count=500)

gF="Фіба / свінг"
lb       = input.int(10,  "Свінг lookback (барів)", group=gF)
fibLvl   = input.float(0.886, "Рівень фіби", step=0.001, group=gF)

gT="Тренд / фільтри"
emaLen   = input.int(200, "EMA тренду", group=gT)
useVol   = input.bool(true, "Фільтр обсягу (≥ SMA20)", group=gT)
volLen   = input.int(20,  "Обсяг SMA", group=gT)
volMult  = input.float(1.0,"Обсяг ≥ × середнього", step=0.1, group=gT)
useADX   = input.bool(true, "Фільтр ADX", group=gT)
adxMin   = input.int(20,  "ADX ≥", group=gT)
adxLen   = input.int(14,  "ADX/DI довжина", group=gT)
rsiLenI  = input.int(14,  "RSI довжина", group=gT)
rsiLongMin  = input.int(40, "LONG: RSI >", group=gT)
rsiShortMax = input.int(60, "SHORT: RSI <", group=gT)

gR="Ризик / тейк"
stopBuf  = input.float(0.5, "Стоп-буфер (×ATR)", step=0.25, group=gR)
atrLen   = input.int(14,  "ATR довжина", group=gR)
autoRR   = input.bool(true,"Авто-RR під ТФ (1H/4H)", group=gR)
rrLongI  = input.float(2.5,"LONG RR (ручний)", step=0.5, group=gR)
rrShortI = input.float(2.0,"SHORT RR (ручний)", step=0.5, group=gR)

gV="Вигляд"
showZone = input.bool(true, "Підсвічувати режим", group=gV)
showEMA  = input.bool(true, "Показувати EMA200", group=gV)

// ---- індикатори ----
ema    = ta.ema(close, emaLen)
atrVal = ta.atr(atrLen)
rsiVal = ta.rsi(close, rsiLenI)
volSma = ta.sma(volume, volLen)
[diP, diM, adxVal] = ta.dmi(adxLen, adxLen)

// свінг попереднього бару (rolling lb, зсув 1 — без зазирання вперед)
sh = ta.highest(high, lb)[1]
sl = ta.lowest(low,  lb)[1]
rng = sh - sl

// авто-RR: 1H long=3, 1H short=2, 4H long=2, 4H short=1.5
tfMin = timeframe.in_seconds() / 60
isH1  = tfMin <= 60
rrLong  = autoRR ? (isH1 ? 3.0 : 2.0) : rrLongI
rrShort = autoRR ? (isH1 ? 2.0 : 1.5) : rrShortI

// фільтри (volOK авто-вимикається на символах без обсягу, напр. ...CRYPTO-індекс)
hasVol = not na(volSma) and volSma > 0
volOK = not useVol or not hasVol or volume >= volMult * volSma
adxOK = not useADX or adxVal >= adxMin

bull = close > ema
bear = close < ema

lvlLong  = sh - fibLvl * rng
lvlShort = sl + fibLvl * rng

longSig  = bull and rng > 0 and low  <= lvlLong  and close > sl and rsiVal > rsiLongMin  and volOK and adxOK and atrVal > 0
shortSig = bear and rng > 0 and high >= lvlShort and close < sh and rsiVal < rsiShortMax and volOK and adxOK and atrVal > 0

// ---- стан позиції (одна за раз) ----
var int   pos     = 0
var float entryPx = na
var float stopLvl = na
var float takeLvl = na

enterLong  = pos==0 and longSig
enterShort = pos==0 and shortSig and not longSig

if enterLong
    entryPx := lvlLong
    stopLvl := sl - stopBuf*atrVal
    takeLvl := entryPx + rrLong*(entryPx - stopLvl)
    pos := 1
else if enterShort
    entryPx := lvlShort
    stopLvl := sh + stopBuf*atrVal
    takeLvl := entryPx - rrShort*(stopLvl - entryPx)
    pos := -1

exitLong  = false
exitShort = false
exitPx    = float(na)
if pos==1 and not enterLong
    if low <= stopLvl
        exitLong := true
        exitPx   := stopLvl
        pos      := 0
    else if high >= takeLvl
        exitLong := true
        exitPx   := takeLvl
        pos      := 0
else if pos==-1 and not enterShort
    if high >= stopLvl
        exitShort := true
        exitPx    := stopLvl
        pos       := 0
    else if low <= takeLvl
        exitShort := true
        exitPx    := takeLvl
        pos       := 0

// ---- вигляд ----
plot(showEMA ? ema : na, "EMA200", color=color.new(color.gray,0), linewidth=2)
bgcolor(showZone and bull ? color.new(color.green,94) : showZone and bear ? color.new(color.red,93) : na, title="Режим")

plot(pos!=0 ? entryPx : na, "ТВХ",  color=color.new(color.white,0), style=plot.style_linebr, linewidth=2)
plot(pos!=0 ? stopLvl : na, "СТОП", color=color.new(color.red,0),   style=plot.style_linebr, linewidth=2)
plot(pos!=0 ? takeLvl : na, "ТЕЙК", color=color.new(color.aqua,0),  style=plot.style_linebr, linewidth=2)

// рівень фіби 0.886 для поточного режиму (де чекаємо вхід) — яскрава товста лінія
fibActive = rng>0 ? (bull ? lvlLong : lvlShort) : na
plot(fibActive, "Рівень фіби 0.886", color=color.new(color.yellow,0), style=plot.style_stepline, linewidth=3)

plotshape(enterLong,  title="LONG",  style=shape.triangleup,   location=location.belowbar, color=color.new(color.lime,0), size=size.tiny, text="LONG")
plotshape(enterShort, title="SHORT", style=shape.triangledown, location=location.abovebar, color=color.new(color.red,0),  size=size.tiny, text="SHORT")
plotshape(exitLong or exitShort, title="EXIT", style=shape.xcross, location=location.absolute, color=color.new(color.yellow,0), size=size.small)

if enterLong
    label.new(bar_index, low, "LONG @ "+str.tostring(entryPx,format.mintick)+"\nстоп "+str.tostring(stopLvl,format.mintick)+" | тейк "+str.tostring(takeLvl,format.mintick), yloc=yloc.belowbar, color=color.new(color.green,0), textcolor=color.white, style=label.style_label_up, size=size.large)
if enterShort
    label.new(bar_index, high, "SHORT @ "+str.tostring(entryPx,format.mintick)+"\nстоп "+str.tostring(stopLvl,format.mintick)+" | тейк "+str.tostring(takeLvl,format.mintick), yloc=yloc.abovebar, color=color.new(color.red,0), textcolor=color.white, style=label.style_label_down, size=size.large)
if exitLong or exitShort
    label.new(bar_index, exitLong?high:low, "EXIT @ "+str.tostring(exitPx,format.mintick), yloc=exitLong?yloc.abovebar:yloc.belowbar, color=color.new(color.gray,0), textcolor=color.white, style=exitLong?label.style_label_down:label.style_label_up, size=size.normal)

// ---- алерти ----
alertcondition(enterLong,  title="LONG вхід",  message="FibPool: ВІДКРИТИ ЛОНГ {{ticker}} @ {{close}}")
alertcondition(enterShort, title="SHORT вхід", message="FibPool: ВІДКРИТИ ШОРТ {{ticker}} @ {{close}}")
alertcondition(exitLong,   title="LONG вихід", message="FibPool: ЗАКРИТИ ЛОНГ {{ticker}} @ {{close}}")
alertcondition(exitShort,  title="SHORT вихід",message="FibPool: ЗАКРИТИ ШОРТ {{ticker}} @ {{close}}")
alertcondition(enterLong or enterShort or exitLong or exitShort, title="Будь-який сигнал", message="FibPool: сигнал {{ticker}} @ {{close}}")
