# Скопіюй у bot.env і заповни. НІКОЛИ не коміть bot.env з ключами!
# Telegram
TG_TOKEN=
TG_CHAT_ID=

# Binance API (дозволи: тільки Futures Trade; ВИВІД ВИМКНУТИ; за можливості IP-whitelist VPS)
BINANCE_KEY=
BINANCE_SECRET=

# Безпека (стартові значення — НЕ чіпай, поки не пройдеш папір+testnet)
BOT_DRY_RUN=1            # 1=папір (нічого реального). 0=реальні ордери
BOT_TESTNET=0            # ПАПІР: 0 = реальні ціни з мейннету (рекомендовано для паперу).
                         # Testnet-етап (реальні ордери, тестові гроші): 1 разом із DRY_RUN=0
BOT_RISK=0.005           # ризик на угоду (0.005 = 0.5%)
BOT_MAX_DAILY_LOSS=0.10  # kill-switch: денний збиток 10% -> стоп входів
BOT_REPORT_HOUR=8        # година UTC для щоденного звіту
BOT_NOTIFY_TRADES=1      # 1=слати в TG кожну угоду (вхід/вихід). 0=тільки щоденний звіт
BOT_PAPER_EQUITY=1000    # стартовий депозит для паперового режиму
