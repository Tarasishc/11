//@version=5
// KC Breakout Signals — сигнальний індикатор для ручного входу (BTC/ETH/SOL, 4h).
// Точно повторює стратегію дослідження (§18): Keltner(EMA20, 2*ATR10) + EMA200 + ADX(14)>20.
// ta.ema/ta.atr(RMA)/ta.dmi — Wilder, збігаються з python-движком.
// Як юзати: додай на графік (4h), створи Alert -> Condition "KC LONG/SHORT" -> "Once Per Bar Close".
indicator("KC Breakout Signals (4h)", overlay=true)

adxMin   = input.int(20,  "ADX min")
kcEma    = input.int(20,  "Keltner EMA")
kcAtrLen = input.int(10,  "Keltner ATR")
kcMult   = input.float(2.0,"Keltner mult")
trendLen = input.int(200, "Trend EMA")
atrStop  = input.int(14,  "ATR (stop)")
rr       = input.float(2.0,"Reward:Risk")

mid    = ta.ema(close, kcEma)
band   = kcMult * ta.atr(kcAtrLen)
upper  = mid + band
lower  = mid - band
trend  = ta.ema(close, trendLen)
[diP, diM, adxv] = ta.dmi(14, 14)
sd     = ta.atr(atrStop) * 2.0          // дистанція стопа = 2*ATR(14)

longSig  = close > upper and close > trend and adxv > adxMin
shortSig = close < lower and close < trend and adxv > adxMin
// лише СВІЖИЙ пробій (щоб не спамити, поки ціна за смугою / поки в позиції)
longFresh  = longSig  and not longSig[1]
shortFresh = shortSig and not shortSig[1]

// рівні
stopL = close - sd
tgtL  = close + rr*sd
stopS = close + sd
tgtS  = close - rr*sd

// візуал
plot(trend, "EMA200", color=color.orange, linewidth=2)
plot(upper, "KC upper", color=color.new(color.gray, 40))
plot(lower, "KC lower", color=color.new(color.gray, 40))
plot(mid,   "EMA20",   color=color.new(color.blue, 70))
plotshape(longFresh,  "LONG",  shape.triangleup,   location.belowbar, color.new(color.green,0), size=size.small)
plotshape(shortFresh, "SHORT", shape.triangledown, location.abovebar, color.new(color.red,0),   size=size.small)

// багатий алерт із рівнями (спрацьовує на ЗАКРИТТІ бара)
if barstate.isconfirmed and longFresh
    alert("🟢 LONG " + syminfo.ticker + " 4h | вхід " + str.tostring(close, format.mintick) +
          " | стоп " + str.tostring(stopL, format.mintick) + " | тейк " + str.tostring(tgtL, format.mintick) +
          " | ADX " + str.tostring(adxv, "#"), alert.freq_once_per_bar_close)
if barstate.isconfirmed and shortFresh
    alert("🔴 SHORT " + syminfo.ticker + " 4h | вхід " + str.tostring(close, format.mintick) +
          " | стоп " + str.tostring(stopS, format.mintick) + " | тейк " + str.tostring(tgtS, format.mintick) +
          " | ADX " + str.tostring(adxv, "#"), alert.freq_once_per_bar_close)

// прості умови для діалогу Alerts (теж постав "Once Per Bar Close")
alertcondition(longFresh,  "KC LONG",  "KC LONG breakout")
alertcondition(shortFresh, "KC SHORT", "KC SHORT breakout")

// табличка з поточними рівнями (зручно для ручного входу)
var table t = table.new(position.top_right, 2, 4, border_width=1)
if barstate.islast
    table.cell(t, 0, 0, "ADX", text_color=color.white, bgcolor=color.gray)
    table.cell(t, 1, 0, str.tostring(adxv, "#.#"), text_color=color.white, bgcolor=adxv>adxMin?color.green:color.red)
    table.cell(t, 0, 1, "ціна", text_color=color.white, bgcolor=color.gray)
    table.cell(t, 1, 1, str.tostring(close, format.mintick), text_color=color.white, bgcolor=color.gray)
    table.cell(t, 0, 2, "верх KC", text_color=color.white, bgcolor=color.gray)
    table.cell(t, 1, 2, str.tostring(upper, format.mintick), text_color=color.white, bgcolor=color.gray)
    table.cell(t, 0, 3, "низ KC", text_color=color.white, bgcolor=color.gray)
    table.cell(t, 1, 3, str.tostring(lower, format.mintick), text_color=color.white, bgcolor=color.gray)
