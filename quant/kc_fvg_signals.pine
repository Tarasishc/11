//@version=5
// ============================================================================
//  KC + FVG — сигнальний індикатор для РУЧНОГО входу (BTC/ETH/SOL, таймфрейм 4h)
//  Робоча зв'язка з дослідження (§13 + §27): два незалежні двигуни на одному графіку.
//    1) KC breakout  — пробій каналу Кельтнера в бік тренду (маркет-вхід)
//    2) FVG retest   — повернення ціни в 3-барний імбаланс у бік тренду (лімітка)
//  ta.ema / ta.atr (RMA) / ta.dmi — Wilder-згладжування, збігається з python-движком.
//  NON-REPAINT: сигнали/бокси малюються лише на ЗАКРИТІЙ свічці (barstate.isconfirmed),
//  тому НЕ зникають після появи. Заходити — на закритті 4h-бара (= коли прийшов алерт).
//  "Одна угода за раз на двигун" (як у бектесті): макс 1 KC + 1 FVG на монету.
//  "Одна позиція на монету" (реально руками: два шорти на біржі зливаються в одну):
//  поки є позиція на цьому символі — нові сигнали не показуються. Через монети — ок.
//  Алерти: створи Alert -> "Any alert() function call" -> "Once Per Bar Close".
// ============================================================================
indicator("KC + FVG Signals (4h)", overlay=true, max_boxes_count=500, max_labels_count=500, max_lines_count=500)

// ----------------------------- Параметри ------------------------------------
grpT = "Тренд / фільтр"
trendLen = input.int(200, "EMA тренду", group=grpT)
adxLen   = input.int(14,  "ADX довжина", group=grpT)
adxMin   = input.float(20, "ADX мінімум (тільки KC)", group=grpT)

grpK = "Keltner breakout"
kcEma    = input.int(20,   "KC: EMA середини", group=grpK)
kcAtrLen = input.int(10,   "KC: ATR каналу",  group=grpK)
kcMult   = input.float(2.0,"KC: множник ATR", group=grpK)

grpF = "FVG retest"
fvgLook  = input.int(20,   "FVG: вікно ретесту (барів)", group=grpF)
fvgFloor = input.float(0.5,"FVG: мін. стоп у ATR(14)",   group=grpF)

grpG = "Загальне"
stopAtr  = input.int(14,   "ATR для стопу",   group=grpG)
kcStopX  = input.float(2.0,"KC: стоп = ATR×", group=grpG)
rr       = input.float(2.0,"Risk : Reward",   group=grpG)
showKC   = input.bool(true, "Сигнали KC",       group=grpG)
showFVG  = input.bool(true, "Сигнали FVG",      group=grpG)
showZones= input.bool(false,"Малювати зони FVG (імбаланс)",group=grpG)
oneAtTime= input.bool(true, "Одна угода за раз на двигун (як у тестах)",group=grpG)
perCoin  = input.bool(true, "Одна позиція на МОНЕТУ (бо 2 шорти зливаються)",group=grpG)

grpR = "RR-бокс (як інструмент Long/Short Position)"
boxBars = input.int(10, "Ширина боксу (барів вправо)", group=grpR)
maxBoxes= input.int(3,  "Показувати боксом лише N останніх сигналів", minval=1, group=grpR)
showLbl = input.bool(true, "Підпис із цінами на боксі", group=grpR)
showWait= input.bool(true, "Підпис WAIT на поточній свічці", group=grpR)
markAll = input.bool(true, "Трикутники-маркери для ВСІХ сигналів", group=grpR)

// сховища намальованих об'єктів, щоб лишати лише N останніх боксів (решта — захаращують)
var allBoxes  = array.new_box()
var allLines  = array.new_line()
var allLabels = array.new_label()

// малює готову позицію: зелена зона профіту + червона зона ризику + лінія входу
f_drawRR(isLong, e, s, t) =>
    l = bar_index
    r = bar_index + boxBars
    array.push(allBoxes, box.new(l, math.max(e, t), r, math.min(e, t), border_color=color.new(color.green, 50), bgcolor=color.new(color.green, 80)))
    array.push(allBoxes, box.new(l, math.max(e, s), r, math.min(e, s), border_color=color.new(color.red, 50),   bgcolor=color.new(color.red, 80)))
    array.push(allLines, line.new(l, e, r, e, color=color.new(color.blue, 0), width=1))
    if showLbl
        pT = math.abs((t - e) / e * 100)
        pS = math.abs((s - e) / e * 100)
        txt = (isLong ? "LONG  " : "SHORT  ") + str.tostring(e, format.mintick) + "\n🎯 " + str.tostring(t, format.mintick) + " (" + str.tostring(pT, "#.#") + "%)\n🛑 " + str.tostring(s, format.mintick) + " (" + str.tostring(pS, "#.#") + "%)\nRR 1:" + str.tostring(rr, "#.#")
        array.push(allLabels, label.new(r, e, txt, style=label.style_label_left, color=color.new(isLong ? color.green : color.red, 20), textcolor=color.white, size=size.small))
    // лишаємо лише N останніх сигналів (2 бокси на сигнал), решту видаляємо
    while array.size(allBoxes) > maxBoxes * 2
        box.delete(array.shift(allBoxes))
    while array.size(allLines) > maxBoxes
        line.delete(array.shift(allLines))
    while array.size(allLabels) > maxBoxes
        label.delete(array.shift(allLabels))

// ----------------------------- Індикатори -----------------------------------
trend = ta.ema(close, trendLen)
mid   = ta.ema(close, kcEma)
band  = kcMult * ta.atr(kcAtrLen)
upper = mid + band
lower = mid - band
[diP, diM, adxv] = ta.dmi(adxLen, adxLen)
atr14 = ta.atr(stopAtr)

plot(trend, "EMA200",   color=color.orange, linewidth=2)
plot(upper, "KC верх",  color=color.new(color.teal, 50))
plot(lower, "KC низ",   color=color.new(color.teal, 50))
plot(mid,   "KC mid",   color=color.new(color.gray, 70))

// =================== ДВИГУН 1: KC BREAKOUT (маркет) =========================
kcLong  = showKC and not na(trend) and not na(adxv) and close > upper and close > trend and adxv >= adxMin
kcShort = showKC and not na(trend) and not na(adxv) and close < lower and close < trend and adxv >= adxMin
// лише СВІЖИЙ пробій (не спамити, поки ціна тримається за смугою)
kcLongFresh  = kcLong  and not kcLong[1]
kcShortFresh = kcShort and not kcShort[1]

// стан відкритих позицій обох двигунів (резолвимо ОБИДВА на початку бара)
var bool  kcIn     = false
var bool  kcLongP  = false
var float kcS = na
var float kcT = na
var bool  fvgIn    = false
var bool  fvgLongP = false
var float fvgS = na
var float fvgT = na
if barstate.isconfirmed and kcIn
    if (kcLongP ? low <= kcS : high >= kcS) or (kcLongP ? high >= kcT : low <= kcT)
        kcIn := false
if barstate.isconfirmed and fvgIn
    if (fvgLongP ? low <= fvgS : high >= fvgS) or (fvgLongP ? high >= fvgT : low <= fvgT)
        fvgIn := false

// блокування: у режимі perCoin нова угода тільки коли НЕМАЄ жодної позиції на монеті
blockKC = perCoin ? (kcIn or fvgIn) : kcIn
kcLongFire  = kcLongFresh  and barstate.isconfirmed and (not oneAtTime or not blockKC)
kcShortFire = kcShortFresh and barstate.isconfirmed and (not oneAtTime or not blockKC)

if kcLongFire
    D = kcStopX * atr14
    e = close
    s = close - D
    t = close + rr * D
    f_drawRR(true, e, s, t)
    kcIn := true
    kcLongP := true
    kcS := s
    kcT := t
    alert("🟢 KC LONG " + syminfo.ticker + " | вхід(маркет) " + str.tostring(e, format.mintick) + " | стоп " + str.tostring(s, format.mintick) + " | тейк " + str.tostring(t, format.mintick) + " | ADX " + str.tostring(adxv, "#"), alert.freq_once_per_bar_close)
if kcShortFire
    D = kcStopX * atr14
    e = close
    s = close + D
    t = close - rr * D
    f_drawRR(false, e, s, t)
    kcIn := true
    kcLongP := false
    kcS := s
    kcT := t
    alert("🔴 KC SHORT " + syminfo.ticker + " | вхід(маркет) " + str.tostring(e, format.mintick) + " | стоп " + str.tostring(s, format.mintick) + " | тейк " + str.tostring(t, format.mintick) + " | ADX " + str.tostring(adxv, "#"), alert.freq_once_per_bar_close)

// =================== ДВИГУН 2: FVG RETEST (лімітка) =========================
// активні зони зберігаємо в масивах: top(zt), bottom(zb), бар-дедлайн(expiry)
var bZt = array.new_float()   // бичачі (long)
var bZb = array.new_float()
var bEx = array.new_int()
var sZt = array.new_float()   // ведмежі (short)
var sZb = array.new_float()
var sEx = array.new_int()

bool  fvgLong  = false
bool  fvgShort = false
float leZt = na
float leSt = na
float leTg = na
float seZt = na
float seSt = na
float seTg = na

if showFVG and barstate.isconfirmed
    // --- 1) спершу ретест наявних зон (тому сигнал не спрацює на барі формування) ---
    i = 0
    while i < array.size(bZt)
        zt = array.get(bZt, i)
        zb = array.get(bZb, i)
        ex = array.get(bEx, i)
        hit = low <= zt and not na(trend) and close > trend
        if hit
            D = math.max(zt - zb, fvgFloor * atr14)
            leZt := zt
            leSt := zt - D
            leTg := zt + rr * D
            fvgLong := true
        if hit or bar_index > ex
            array.remove(bZt, i)
            array.remove(bZb, i)
            array.remove(bEx, i)
        else
            i += 1
    j = 0
    while j < array.size(sZt)
        zt = array.get(sZt, j)
        zb = array.get(sZb, j)
        ex = array.get(sEx, j)
        hit = high >= zt and not na(trend) and close < trend
        if hit
            D = math.max(zb - zt, fvgFloor * atr14)
            seZt := zt
            seSt := zt + D
            seTg := zt - rr * D
            fvgShort := true
        if hit or bar_index > ex
            array.remove(sZt, j)
            array.remove(sZb, j)
            array.remove(sEx, j)
        else
            j += 1
    // --- 2) виявлення нових FVG (3-барний імбаланс) у бік тренду ---
    if not na(trend) and high[2] < low and close > trend          // бичачий розрив
        array.push(bZt, low)
        array.push(bZb, high[2])
        array.push(bEx, bar_index + fvgLook)
        if showZones
            box.new(bar_index, low, bar_index + fvgLook, high[2], border_color=color.new(color.green, 40), bgcolor=color.new(color.green, 88))
    if not na(trend) and low[2] > high and close < trend          // ведмежий розрив
        array.push(sZt, high)
        array.push(sZb, low[2])
        array.push(sEx, bar_index + fvgLook)
        if showZones
            box.new(bar_index, low[2], bar_index + fvgLook, high, border_color=color.new(color.red, 40), bgcolor=color.new(color.red, 88))

// блокування FVG (рахуємо тут, бо KC міг відкрити позицію цього ж бара)
blockFVG = perCoin ? (kcIn or fvgIn) : fvgIn
fvgLongFire  = fvgLong  and (not oneAtTime or not blockFVG)
fvgShortFire = fvgShort and (not oneAtTime or not blockFVG)

if fvgLongFire
    f_drawRR(true, leZt, leSt, leTg)
    fvgIn := true
    fvgLongP := true
    fvgS := leSt
    fvgT := leTg
    alert("🟩 FVG LONG " + syminfo.ticker + " | лімітка " + str.tostring(leZt, format.mintick) + " | стоп " + str.tostring(leSt, format.mintick) + " | тейк " + str.tostring(leTg, format.mintick), alert.freq_once_per_bar_close)
if fvgShortFire
    f_drawRR(false, seZt, seSt, seTg)
    fvgIn := true
    fvgLongP := false
    fvgS := seSt
    fvgT := seTg
    alert("🟥 FVG SHORT " + syminfo.ticker + " | лімітка " + str.tostring(seZt, format.mintick) + " | стоп " + str.tostring(seSt, format.mintick) + " | тейк " + str.tostring(seTg, format.mintick), alert.freq_once_per_bar_close)

// маленькі маркери на КОЖНІЙ ВЗЯТІЙ угоді (історія видна, без захаращення боксами)
plotshape(markAll and kcLongFire,  "KC long",  shape.triangleup,   location.belowbar, color.new(color.green, 0),   size=size.tiny)
plotshape(markAll and kcShortFire, "KC short", shape.triangledown, location.abovebar, color.new(color.red, 0),     size=size.tiny)
plotshape(markAll and fvgLongFire, "FVG long", shape.triangleup,   location.belowbar, color.new(color.lime, 0),    size=size.tiny)
plotshape(markAll and fvgShortFire,"FVG short",shape.triangledown, location.abovebar, color.new(color.fuchsia, 0), size=size.tiny)

// ----------------------------- Табличка стану -------------------------------
var table tb = table.new(position.top_right, 2, 4, border_width=1)
if barstate.islast
    table.cell(tb, 0, 0, "ADX", text_color=color.white, bgcolor=color.gray)
    table.cell(tb, 1, 0, str.tostring(adxv, "#.#"), text_color=color.white, bgcolor = adxv >= adxMin ? color.green : color.red)
    table.cell(tb, 0, 1, "ціна > EMA200?", text_color=color.white, bgcolor=color.gray)
    table.cell(tb, 1, 1, close > trend ? "так (лонги)" : "ні (шорти)", text_color=color.white, bgcolor = close > trend ? color.green : color.red)
    table.cell(tb, 0, 2, "активних FVG", text_color=color.white, bgcolor=color.gray)
    table.cell(tb, 1, 2, str.tostring(array.size(bZt) + array.size(sZt)), text_color=color.white, bgcolor=color.gray)
    posTxt = (kcIn ? "KC " : "") + (fvgIn ? "FVG" : "")
    posTxt := posTxt == "" ? "вільно" : posTxt
    table.cell(tb, 0, 3, "в угоді", text_color=color.white, bgcolor=color.gray)
    table.cell(tb, 1, 3, posTxt, text_color=color.white, bgcolor = (kcIn or fvgIn) ? color.orange : color.green)

// ----------------------------- Нагадування «не заходь раніше» ---------------
// показуємо ⏳ WAIT над поточною свічкою, поки вона НЕ закрилась; зникає на закритті
var label wlab = na
if showWait and barstate.islast
    label.delete(wlab)
    if not barstate.isconfirmed
        wlab := label.new(bar_index, high, "⏳ WAIT\nсвічка не закрита", style=label.style_label_down, color=color.new(color.orange, 15), textcolor=color.white, size=size.small)
